# Set in the frontend server environment AT RUNTIME; root files are not auto-loaded.
API_INTERNAL_URL=http://127.0.0.1:8000
NEUROGENE_ALLOW_LOCAL_API=1
E2E_BASE_URL=http://127.0.0.1:3000
# No API keys or private credentials are required.
# Research is local-only. Public requires explicit approval of an exact manifest.
NEUROGENE_MODE=research
NEUROGENE_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
NEUROGENE_CORS_ORIGINS=
NEUROGENE_REQUESTS_PER_MINUTE=300
NEUROGENE_REQUEST_TIMEOUT=20
